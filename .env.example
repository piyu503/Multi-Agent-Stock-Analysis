# ==============================================================================
# Multi-Agent Stock Analysis Platform — Environment Configuration Template
# Copy this file to '.env' (for backend) or 'frontend/.env.local' (for frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security & CORS (comma-separated or JSON list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (SQLAlchemy 2.x asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/stock_analysis
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=3.0

# ------------------------------------------------------------------------------
# Supabase Authentication (Future Phase)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# AI & LLM Provider Configuration (Future Phase)
# Supported options: 'gemini', 'openai', 'anthropic', 'local'
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-placeholder

# ------------------------------------------------------------------------------
# Frontend Settings (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
